# ==========================================
# n8n Environment Configuration Template
# ==========================================

# PostgreSQL Configuration
POSTGRES_USER=n8n
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=n8n

# n8n Security & Encryption Key
N8N_ENCRYPTION_KEY=your_256_bit_encryption_key_here

# n8n Host & Domain Configuration
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Timezone
GENERIC_TIMEZONE=Asia/Kolkata
